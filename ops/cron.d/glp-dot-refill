# DOT1 safe idle refill. Fleet ingestion remains owned by its existing Hermes job.
SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin
*/15 * * * * ubuntu cd /home/ubuntu/business && /usr/bin/timeout --foreground --signal=TERM --kill-after=10 180 /home/ubuntu/.hermes/hermes-agent/venv/bin/python3 -B scripts/dot_lane.py refill >> /home/ubuntu/business/reports/ops/dot-refill/CRON.log 2>&1
